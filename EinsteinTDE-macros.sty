% ==== secnat.sty (section-heading formatting, verbatim) ====
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\maybe@addperiod}[1]{%
  #1\@addpunct{.}%
}

\usepackage[explicit]{titlesec}

\titleformat{\part}
  {\normalfont}{\normalsize\bfseries\boldmath{Part \thepart}}{1em}{\normalsize\bfseries\boldmath{#1}}

\renewcommand\section{\@startsection{section}{1}{\z@}%
           {-18\p@ \@plus 6\p@ \@minus 3\p@}%
           {9\p@ \@plus 6\p@ \@minus 3\p@}%
           {\normalsize\bfseries\boldmath}}

\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
           {-12\p@ \@plus 6\p@ \@minus 3\p@}%
           {4\p@ \@plus 6\p@ \@minus 3\p@}%
           {\normalfont\normalsize\itshape}}

\renewcommand\subsubsection{\@startsection{subsubsection}{2}{\z@}%
           {-12\p@ \@plus 6\p@ \@minus 3\p@}%
           {4\p@ \@plus 6\p@ \@minus 3\p@}%
           {\normalfont\normalsize}}

\renewcommand\paragraph{\@startsection{paragraph}{4}{\z@}%
                                    {3.25ex \@plus1ex \@minus.2ex}%
                                    {-1em}%
                                    {\normalfont\normalsize\itshape\maybe@addperiod}}%

