% ==== natbibspec.sty (natbib-specific patches: \cite, \citets, \rev, ====
% ====   auto-period-after-footnote), verbatim                        ====
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\renewcommand{\rev}[1]{Review of \citealp{#1}}
\renewcommand{\cite}{\citealp}
\renewcommand{\citets}[2][]{\citeauthor{#2}'s (\citeyear{#2}\if\relax\detokenize{#1}\relax\else: #1\fi)}
\@ifundefined{blx@sf@period}{\mathchardef\blx@sf@period=1006}{}
\usepackage{bigfoot}

\let\orig@footnote\footnote
\let\orig@footnotetext\footnotetext

\RenewDocumentCommand{\footnote}{o +m}{%
  \IfNoValueTF{#1}%
    {\orig@footnote{#2\@addpunct{.}}}%
    {\orig@footnote[#1]{#2\@addpunct{.}}}%
}

\RenewDocumentCommand{\footnotetext}{o +m}{%
  \IfNoValueTF{#1}%
    {\orig@footnotetext{#2\@addpunct{.}}}%
    {\orig@footnotetext[#1]{#2\@addpunct{.}}}%
}

