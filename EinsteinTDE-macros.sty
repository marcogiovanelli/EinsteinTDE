\NewDocumentCommand\q{moo}{%
\IfNoValueTF {#3}%
   {\@ifnextchar,{\blockquote{#1,}\@gobble}{\blockquote{#1}\hide{#2}}}%
   {%
  \IfNoValueTF {#2}%
  {\blockquote[{#3}]{#1}\hide{#2}}
{\IfNoValueTF {#3}%
{\blockquote[{#3}]{#1}\hide{#2}}%
{\blockquote[{#3}]{#1}\hide{#2}}%
}
}
\unspace}

\NewDocumentCommand\qt{mmo}{%
\IfNoValueTF {#3}%
   {\@ifnextchar,{\blockquote{#1,}\@gobble}{\blockquote{#1}\hide{#2}}}%
   {%
