\usepackage[ddmmyyyy]{datetime}
\usepackage[american]{isodate}

\newdateformat{am}{\monthname[\THEMONTH]\xspace\THEDAY,\xspace\THEYEAR}
\newdateformat{moyeam}{\monthname[\THEMONTH] of \THEYEAR}

\renewcommand{\shortmonthname}{%
  \ifcase\THEMONTH
  \or Jan.\
  \or Feb.\
  \or Mar.\
  \or Apr.\
  \or May
  \or Jun.\
  \or Jul.\
  \or Aug.\
  \or Sep.\
  \or Oct.\
  \or Nov.\
  \or Dec.\
  \fi}

\newdateformat{shortmoam}{\shortmonthname\THEDAY,\xspace\THEYEAR}

\DeclareDocumentCommand\datef{mmm}{\am\formatdate{#1}{#2}{#3}}
\DeclareDocumentCommand\datemy{mmm}{\moyeam\formatdate{0}{#2}{#3}}

